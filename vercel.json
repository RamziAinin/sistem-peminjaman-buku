{
    "version": 2,
    "builds": [
        {
            "src": "api/index.php",
            "use": "vercel-php@0.6.2"
        },
        {
            "src": "public/(build|assets|css|js|images)/(.*)",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/(build|assets|css|js|images)/(.*)",
            "dest": "public/$1/$2"
        },
        {
            "src": "/(.*)",
            "dest": "api/index.php"
        }
    ]
}